+/// Inspect browser controls without descending into the current document.
+/// Web roots remain visible, but this result must never prove a page control.
+/// Scoped RAII restoration also handles nested calls and unwinding.
+pub fn walk_browser_chrome(pid: i32, window_id: u32) -> TreeWalkResult {
+    struct Restore(bool);
+    impl Drop for Restore {
+        fn drop(&mut self) { BROWSER_CHROME_ONLY.with(|flag| flag.set(self.0)); }
+    }
+    let _restore = Restore(BROWSER_CHROME_ONLY.with(|flag| flag.replace(true)));
+    with_menus_collapsed(true, || walk_tree(pid, Some(window_id), None))
+}
