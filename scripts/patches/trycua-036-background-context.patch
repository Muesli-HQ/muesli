+#[tokio::test]
+#[ignore = "Run with MUESLI_CHROME_MANUAL_RECONNECT=1; process-scoped policy"]
+async fn muesli_manual_reconnect_never_redials_after_socket_loss() {
+    assert_eq!(std::env::var("MUESLI_CHROME_MANUAL_RECONNECT").as_deref(), Ok("1"));
+    let (f, _provider) = protected_existing_profile_fixture().await;
+    let args = json!({"pid": 1, "window_id": 7, "session": "manual-test",
+        "_transport_session_id": "manual-transport", "strategy": {"kind": "existing_profile"}});
+    let prepared = BrowserPrepareTool::new(f.engine.clone()).invoke({ let mut initial = args.clone(); initial["delivery_mode"] = json!("foreground"); initial }).await;
+    assert_eq!(structured(&prepared)["status"], "ok");
+    let state = GetBrowserStateTool::new(f.engine.clone()).invoke(args.clone()).await;
+    assert_eq!(structured(&state)["status"], "ok");
+    let status = super::tools::BrowserConnectionStatusTool::new(f.engine.clone());
+    let live = status.invoke(args.clone()).await;
+    assert_eq!(structured(&live)["connected"], true);
+    let count = f._server.accepted_connections();
+    let grant = f.engine.existing_profile_grant("manual-test", Some("manual-transport"), 1)
+        .await.unwrap().unwrap();
+    let connection = f.engine.pool.get_existing(&grant.endpoint_ws_url, grant.generation).await.unwrap();
+    let mut closed = connection.subscribe_close();
+    assert!(!*closed.borrow());
+    drop(connection);
+    f.engine.pool.release_existing(&grant.endpoint_ws_url, grant.generation,
+        super::cdp_ws::SharedSocketRelease::Close).await;
+    tokio::time::timeout(std::time::Duration::from_secs(1), closed.changed()).await.unwrap().unwrap();
+    assert!(*closed.borrow());
+    // Late subscribers must observe closure without waiting for another event.
+    assert!(*closed.clone().borrow());
+    let disconnected = status.invoke(args.clone()).await;
+    assert_eq!(structured(&disconnected)["connected"], false);
+    assert_eq!(f._server.accepted_connections(), count, "status must never redial");
+    let refused = GetBrowserStateTool::new(f.engine.clone()).invoke(args).await;
+    assert_eq!(structured(&refused)["refusal"]["code"], "browser_consent_required");
+    assert_eq!(f._server.accepted_connections(), count, "must not reconnect or prompt Chrome");
+    crate::session::fire_session_end("manual-transport");
+}
