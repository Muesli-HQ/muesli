+/// Host-only liveness probe: never discovers, attaches, reads a page or reconnects.
+pub struct BrowserConnectionStatusTool {
+    def: ToolDef,
+    engine: Arc<BrowserEngine>,
+}
+impl BrowserConnectionStatusTool {
+    pub fn new(engine: Arc<BrowserEngine>) -> Self {
+        Self { engine, def: ToolDef {
+            name: "browser_connection_status".into(),
+            description: "Check the existing approved browser socket without connecting or reading page content.".into(),
+            input_schema: json!({"type":"object", "properties": {
+                "pid":{"type":"integer"}, "watch":{"type":"boolean"}, "session":schema_session()}, "required":["pid","session"]}),
+            read_only: true, destructive: false, idempotent: true, open_world: false,
+        }}
+    }
+}
+#[async_trait]
+impl Tool for BrowserConnectionStatusTool {
+    fn def(&self) -> &ToolDef { &self.def }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let session = match require_explicit_session(&args) {
+            Ok(session) => session, Err(error) => return error,
+        };
+        let Some(pid) = args.get("pid").and_then(Value::as_i64) else {
+            return ToolResult::error("pid is required");
+        };
+        let transport = args.get("_transport_session_id").and_then(Value::as_str);
+        let connection = match self.engine.existing_profile_grant(&session, transport, pid).await {
+            Ok(Some(grant)) => self.engine.pool.get_existing(&grant.endpoint_ws_url, grant.generation).await.ok(),
+            _ => None,
+        };
+        let connected = connection.as_ref().is_some_and(|connection| !connection.is_closed());
+        if args.get("watch").and_then(Value::as_bool) == Some(true) {
+            if let (Some(connection), Ok(path)) = (connection, std::env::var("MUESLI_CHROME_EVENTS_PATH")) {
+                // The event destination comes only from the embedding host, never
+                // tool arguments. The private per-daemon file is watched by kqueue.
+                let mut closed = connection.subscribe_close();
+                tokio::spawn(async move {
+                    while !*closed.borrow_and_update() {
+                        if closed.changed().await.is_err() { break; }
+                    }
+                    use std::io::Write;
+                    if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+                        let event = json!({"session":crate::session::public_session_label(&session), "connected":false});
+                        let line = format!("{event}\n");
