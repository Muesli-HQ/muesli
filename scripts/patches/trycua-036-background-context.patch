+// Ported from Swift SyntheticAppFocusEnforcer at upstream 53e6736f0bc5.
+// Unlike the historical implementation, never overwrite an unreadable prior
+// value: a best-effort write without a restorable value can leave focus changed.
+trait FocusAttributes {
+    fn read(&self, target: usize, attribute: &str) -> Option<bool>;
+    fn write(&self, target: usize, attribute: &str, value: bool) -> bool;
+}
+
+struct SyntheticFocus<B: FocusAttributes> {
+    backend: B,
+    changed: Vec<(usize, &'static str, bool)>,
+}
+
+impl<B: FocusAttributes> SyntheticFocus<B> {
+    fn begin(backend: B, minimized: Option<bool>) -> Self {
+        let mut lease = Self {
+            backend,
+            changed: Vec::new(),
+        };
+        // Unknown minimized state is not permission to deminiaturize a window.
+        if minimized != Some(false) {
+            return lease;
+        }
+        for (target, attribute) in [(0, "AXFocused"), (0, "AXMain"), (1, "AXFocused")] {
+            if let Some(false) = lease.backend.read(target, attribute) {
+                if lease.backend.write(target, attribute, true) {
+                    lease.changed.push((target, attribute, false));
+                }
+            }
+        }
+        lease
+    }
+}
+
+impl<B: FocusAttributes> Drop for SyntheticFocus<B> {
+    fn drop(&mut self) {
+        for &(target, attribute, prior) in self.changed.iter().rev() {
+            // Do not overwrite a newer externally changed value on cleanup.
+            if self.backend.read(target, attribute) == Some(true) {
+                self.backend.write(target, attribute, prior);
+            }
+        }
+    }
+}
+
+struct NativeFocusAttributes {
+    targets: [crate::ax::snapshot::RetainedElement; 2],
+}
+
+impl FocusAttributes for NativeFocusAttributes {
+    fn read(&self, target: usize, attribute: &str) -> Option<bool> {
+        unsafe {
+            crate::ax::bindings::copy_bool_attr(self.targets[target].as_ptr() as _, attribute)
+        }
+    }
+    fn write(&self, target: usize, attribute: &str, value: bool) -> bool {
+        use core_foundation::{base::TCFType, boolean::CFBoolean, string::CFString};
+        let name = CFString::new(attribute);
+        let value = if value {
+            CFBoolean::true_value()
+        } else {
+            CFBoolean::false_value()
+        };
+        unsafe {
+            crate::ax::bindings::AXUIElementSetAttributeValue(
+                self.targets[target].as_ptr() as _,
+                name.as_concrete_TypeRef(),
+                value.as_CFTypeRef(),
+            ) == crate::ax::bindings::kAXErrorSuccess
+        }
+    }
+}
+
+/// Hold on the blocking AX worker, inside the existing reactive suppression
+/// lease. Restores focus attributes on success, error and panic; cancellation
+/// cannot drop it before the underlying blocking AX action has actually ended.
+/// No activation, AXRaise, global key input or desktop changes are dispatched.
+///
+/// # Safety
+/// `element` must be a live, already validated AX action target.
+pub unsafe fn synthetic_focus(
+    pid: i32,
+    element: usize,
+    expected_window: Option<u32>,
+) -> Option<impl Drop> {
+    use crate::ax::{bindings::*, snapshot::RetainedElement};
+    use core_foundation::base::{CFRelease, CFTypeRef};
+    let expected_window = expected_window?;
+    if element == 0 || apps::frontmost_pid() == Some(pid) {
+        return None;
+    }
+    let element_ref = element as AXUIElementRef;
+    let window = if copy_string_attr(element_ref, "AXRole").as_deref() == Some("AXWindow") {
+        RetainedElement::retain(element)
+    } else {
+        let copied = copy_element_attr(element_ref, "AXWindow")?;
+        let retained = RetainedElement::retain(copied as usize);
+        CFRelease(copied as CFTypeRef);
+        retained
+    };
+    let window_ref = window.as_ptr() as AXUIElementRef;
+    let mut owner = 0;
+    if AXUIElementGetPid(window_ref, &mut owner) != kAXErrorSuccess
+        || owner != pid
+        || ax_get_window_id(window_ref) != Some(expected_window)
+    {
+        return None;
+    }
+    let minimized = copy_bool_attr(window_ref, "AXMinimized");
+    let root = AXUIElementCreateApplication(pid);
+    if !root.is_null() {
+        crate::ax::enablement::ensure_chromium_ax_enabled(pid, root);
+        CFRelease(root as CFTypeRef);
+    }
+    Some(SyntheticFocus::begin(
+        NativeFocusAttributes {
+            targets: [window, RetainedElement::retain(element)],
+        },
+        minimized,
+    ))
+}
