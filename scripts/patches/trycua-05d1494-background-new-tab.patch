+#[tokio::test]
+async fn new_tab_refuses_stale_anchor_without_creating_anything() {
+    let f = fixture().await;
+    let (target, tab) = bind(&f).await;
+    f.state.lock().unwrap().omit_primary_target = true;
+    let result = BrowserNavigateTool::new(f.engine.clone()).invoke(json!({
+        "target_id": target, "tab_id": tab, "session": SESSION,
+        "url": "https://fixture.test/new", "new_tab": true
+    })).await;
+    assert_ne!(structured(&result)["status"], "ok");
+    assert!(recorded_calls(&f, "Target.createTarget").is_empty());
+    assert!(recorded_calls(&f, "Page.navigate").is_empty());
+}
