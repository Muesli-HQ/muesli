 #[tokio::test]
+async fn new_tab_preserves_anchor_and_forces_background_creation() {
+    let f = fixture().await;
+    let (target, tab) = bind(&f).await;
+    let result = BrowserNavigateTool::new(f.engine.clone()).invoke(json!({
+        "target_id": target, "tab_id": tab, "session": SESSION,
+        "url": "https://fixture.test/new", "new_tab": true,
+        "background": false, "newWindow": true, "focus": true,
+        "browserContextId": "untrusted-profile"
+    })).await;
+    assert_eq!(structured(&result)["status"], "ok", "{result:?}");
+    let creates = recorded_calls(&f, "Target.createTarget");
+    assert_eq!(creates.len(), 1);
+    assert_eq!(creates[0].1, json!({"url":"about:blank", "background":true, "newWindow":false}));
+    let attaches = recorded_calls(&f, "Target.attachToTarget");
+    assert!(attaches.iter().any(|(_, args)| args["targetId"] == "T_NEW"));
+    let nav = recorded_calls(&f, "Page.navigate");
+    assert_eq!(nav.len(), 1);
+    assert_eq!(nav[0].1["url"], "https://fixture.test/new");
+    assert!(recorded_calls(&f, "Page.bringToFront").is_empty());
+    assert!(recorded_calls(&f, "Target.activateTarget").is_empty());
+}
