+#[tokio::test]
+#[ignore = "Run with MUESLI_CHROME_MANUAL_RECONNECT=1 and MUESLI_CHROME_EVENTS_PATH"]
+async fn muesli_event_file_delivers_disconnect_without_status_polling() {
+    let path = std::env::var("MUESLI_CHROME_EVENTS_PATH").unwrap();
+    std::fs::write(&path, "").unwrap();
+    let (f, _provider) = protected_existing_profile_fixture().await;
+    let args = json!({"pid":1,"window_id":7,"session":"__cua_runtime_00112233445566778899aabbccddeeff:event-file-test",
+        "_transport_session_id":"event-transport", "strategy":{"kind":"existing_profile"}});
+    let result = BrowserPrepareTool::new(f.engine.clone()).invoke(args.clone()).await;
+    assert_eq!(structured(&result)["prepared"], true);
+    let mut watch = args.clone();
+    watch["watch"] = json!(true);
+    let status = super::tools::BrowserConnectionStatusTool::new(f.engine.clone()).invoke(watch).await;
+    assert_eq!(structured(&status)["connected"], true);
+    let count = f._server.accepted_connections();
+    let grant = f.engine.existing_profile_grant("__cua_runtime_00112233445566778899aabbccddeeff:event-file-test", Some("event-transport"), 1).await.unwrap().unwrap();
+    f.engine.pool.release_existing(&grant.endpoint_ws_url, grant.generation,
+        super::cdp_ws::SharedSocketRelease::Close).await;
+    // Observe the emitted artifact, without issuing another tool/status call.
+    let event = tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        loop {
+            let text = std::fs::read_to_string(&path).unwrap();
+            if let Some(line) = text.lines().next() {
+                if let Ok(event) = serde_json::from_str::<Value>(line) { break event; }
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    }).await.unwrap();
+    assert_eq!(event, json!({"session":"event-file-test","connected":false}));
+    assert_eq!(f._server.accepted_connections(), count);
+    crate::session::fire_session_end("event-transport");
+}
