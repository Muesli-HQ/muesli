+#[tokio::test]
+#[ignore = "Run separately with and without MUESLI_CHROME_PROFILE_WINDOW_SCOPE=1"]
+async fn muesli_profile_scope_rebinds_without_reconnect_and_preserves_boundaries() {
+    let (f, _) = protected_existing_profile_fixture().await;
+    let prepared = BrowserPrepareTool::new(f.engine.clone()).invoke(json!({
+        "pid":1,"window_id":7,"session":"profile-test","_transport_session_id":"profile-transport",
+        "strategy":{"kind":"existing_profile"}})).await;
+    assert_eq!(structured(&prepared)["prepared"], true);
+    let count = f._server.accepted_connections();
+    let result = f.engine.bind_native("profile-test",Some("profile-transport"),1,8).await;
+    if !super::grant::profile_window_scope_enabled() {
+        assert_eq!(result.unwrap_err().code, super::refusal::BrowserRefusalCode::BrowserBindingStale);
+        return;
+    }
+    let (target, record) = result.unwrap();
+    assert_eq!(record.window_id,8);
+    assert_eq!(record.quality, super::types::BindingQuality::Exact);
+    assert_eq!(f._server.accepted_connections(),count);
+    assert!(!f.setup_invoked.load(Ordering::SeqCst));
+    assert!(f.engine.store.get_target("other-session",&target).is_err());
+    assert!(f.engine.bind_native("other-session",Some("other-transport"),1,8).await.is_err());
+    assert!(f.engine.bind_native("profile-test",Some("profile-transport"),2,8).await.is_err());
+    f.state.lock().unwrap().omit_primary_target = true;
+    assert!(f.engine.bind_native("profile-test",Some("profile-transport"),1,9).await.is_err());
+    f.state.lock().unwrap().omit_primary_target = false;
+    f.engine.revoke_existing_profile_grant("profile-test",Some("profile-transport"),1).await;
+    assert!(f.engine.bind_native("profile-test",Some("profile-transport"),1,8).await.is_err());
+    crate::session::fire_session_end("profile-transport");
+}
