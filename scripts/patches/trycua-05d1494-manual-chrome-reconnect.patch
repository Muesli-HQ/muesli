+/// Host-only liveness probe: never discovers, attaches, reads a page or reconnects.
+pub struct BrowserConnectionStatusTool {
+    def: ToolDef,
+    engine: Arc<BrowserEngine>,
+}
+impl BrowserConnectionStatusTool {
+    pub fn new(engine: Arc<BrowserEngine>) -> Self {
+        Self { engine, def: ToolDef {
+            name: "browser_connection_status".into(),
+            description: "Check the existing approved browser socket without connecting or reading page content.".into(),
+            input_schema: json!({"type":"object", "properties": {
+                "pid":{"type":"integer"}, "session":schema_session()}, "required":["pid","session"]}),
+            read_only: true, destructive: false, idempotent: true, open_world: false,
+        }}
+    }
+}
+#[async_trait]
+impl Tool for BrowserConnectionStatusTool {
+    fn def(&self) -> &ToolDef { &self.def }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let session = match require_explicit_session(&args) {
+            Ok(session) => session, Err(error) => return error,
+        };
+        let Some(pid) = args.get("pid").and_then(Value::as_i64) else {
+            return ToolResult::error("pid is required");
+        };
+        let transport = args.get("_transport_session_id").and_then(Value::as_str);
+        let connected = match self.engine.existing_profile_grant(&session, transport, pid).await {
+            Ok(Some(grant)) => self.engine.pool.get_existing(&grant.endpoint_ws_url, grant.generation)
+                .await.map(|connection| !connection.is_closed()).unwrap_or(false),
+            _ => false,
+        };
+        ToolResult::text(if connected {"Connected"} else {"Reconnect required"})
+            .with_structured(json!({"status":"ok", "connected":connected}))
+    }
+}
