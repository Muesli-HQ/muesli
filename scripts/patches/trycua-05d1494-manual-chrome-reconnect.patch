+#[tokio::test]
+#[ignore = "Run with MUESLI_CHROME_MANUAL_RECONNECT=1"]
+async fn muesli_manual_connect_waits_for_endpoint_without_setup() {
+    assert_eq!(std::env::var("MUESLI_CHROME_MANUAL_RECONNECT").as_deref(), Ok("1"));
+    let visible = Arc::new(AtomicBool::new(false));
+    let (f, _provider) = protected_existing_profile_fixture_with_visibility(visible.clone()).await;
+    let args = json!({"pid": 1, "window_id": 7, "session": "wait-test",
+        "_transport_session_id": "wait-transport", "strategy": {"kind": "existing_profile"}});
+    for _ in 0..3 {
+        let result = BrowserPrepareTool::new(f.engine.clone()).invoke(args.clone()).await;
+        assert_eq!(structured(&result)["refusal"]["code"], "browser_requires_setup");
+        assert!(!f.setup_invoked.load(Ordering::SeqCst));
+        assert_eq!(f._server.accepted_connections(), 0);
+    }
+    visible.store(true, Ordering::SeqCst);
+    let result = BrowserPrepareTool::new(f.engine.clone()).invoke(args).await;
+    assert_eq!(structured(&result)["prepared"], true);
+    assert!(!f.setup_invoked.load(Ordering::SeqCst));
+    crate::session::fire_session_end("wait-transport");
+}
